{
  "$defs": {
    "Cell": {
      "additionalProperties": false,
      "description": "One cell of a grid, anchored at `(row, col)`, spanning `row_span` x `col_span` positions.\n\nA blank cell (no words, text \"\") is part of a table's shape. A `carried` cell is a header copied\nonto a continuation page: it owns no words there, and `source` names the parent-table cells it\ncopies.",
      "properties": {
        "carried": {
          "default": false,
          "title": "Carried",
          "type": "boolean"
        },
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "col_span": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Col Span",
          "type": "integer"
        },
        "markers": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Markers",
          "type": "array"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "row_span": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Row Span",
          "type": "integer"
        },
        "source": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Source",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "word_ids": {
          "default": [],
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Word Ids",
          "type": "array"
        }
      },
      "required": [
        "row",
        "col",
        "row_span",
        "col_span",
        "text",
        "word_ids",
        "carried",
        "source",
        "markers"
      ],
      "title": "Cell",
      "type": "object"
    },
